# RAG Lab Protótipo — Variáveis de Ambiente (Copiar para .env e preencher)
APP_NAME=RAG Lab Protótipo
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

SECRET_KEY=substitua-por-uma-chave-forte-aleatoria
JWT_EXPIRE_MINUTES=1440

DATABASE_URL=sqlite:///./raglab_public.db

UPLOAD_DIR=./storage/uploads
INDEX_DIR=./storage/indexes

CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_TIMEOUT_SECONDS=5
# Provedor de embeddings e geração de texto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text:nq
OLLAMA_GENERATE_TIMEOUT_SECONDS=600

# Chaves de provedores externos (deixar em branco se não usar)
OPENAI_API_KEY=sua-chave-aqui
ANTHROPIC_API_KEY=sua-chave-aqui
GOOGLE_API_KEY=sua-chave-aqui
DEEPSEEK_API_KEY=sua-chave-aqui

DEFAULT_CHAT_PROVIDER=ollama
DEFAULT_EMBEDDING_PROVIDER=ollama
DEFAULT_RAG_STRATEGY=hybrid

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:4173
